<?xml version="1.0" encoding="utf-8"?>
<!--
  The round launcher icon for Android 7 and below. Same drawing; launchers that
  ask for a round icon mask it themselves.

  Android 8+ uses mipmap-anydpi-v26/ic_launcher.xml instead — a more specific
  qualifier always wins — so this is the fallback, not the main icon. It draws
  its own rounded square, because there is no system mask to apply one.

  A vector rather than the five density PNGs it replaces: those were still
  Capacitor's stock icon, which is why the app was showing the wrong logo. One
  drawing that scales is correct at every density and cannot be updated in four
  places with the fifth forgotten.

  Flat blue rather than the gradient the web logo uses: gradient fills in a
  vector need API 24, and this file exists for API 23 to 25. At 48dp the
  gradient is invisible anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <path
        android:fillColor="#1559B8"
        android:pathData="M26,0 L102,0 A26,26 0 0 1 128,26 L128,102 A26,26 0 0 1 102,128 L26,128 A26,26 0 0 1 0,102 L0,26 A26,26 0 0 1 26,0 Z" />

    <!-- Money out, money back. The two arrows are a 180° rotation of each
         other about the centre, so the mark is balanced either way up. -->
    <path
        android:fillColor="#7CB8FF"
        android:pathData="M30,40 L74,40 A6.5,6.5 0 0 1 74,53 L30,53 A6.5,6.5 0 0 1 30,40 Z" />
    <path
        android:fillColor="#7CB8FF"
        android:pathData="M74,30 L100,46.5 L74,63 Z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,76 L98,76 A6.5,6.5 0 0 1 98,89 L54,89 A6.5,6.5 0 0 1 54,76 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,66 L28,82.5 L54,99 Z" />
</vector>
