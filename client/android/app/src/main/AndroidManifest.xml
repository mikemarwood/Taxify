<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.Splash"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!--
              Links in our emails open the app if it is installed.

              Every link Taxify sends — activation, password reset, an
              accountant invitation, a support ticket — points at
              taxify.mikesapphub.com, and the app *is* that site loaded in a
              webview. So a link tapped on a phone with the app installed was
              still opening a browser, signing in a second time, and leaving
              the app it was already signed into sitting in the background.

              autoVerify makes Android check /.well-known/assetlinks.json on
              that host at install time. It only hands us the link if the file
              lists this package and the certificate this build was signed
              with — which is why nothing here can hijack somebody else's
              domain, and why the file has to carry the real fingerprint or
              verification silently fails and links keep going to the browser.

              No app installed, or verification failed: the browser opens it,
              exactly as before. There is no case where the link stops working.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Only the app, not the whole site.
                     Without a path prefix the app also claims the landing
                     page, so somebody tapping a link to the marketing site
                     from a text message would be dropped into a signed-in
                     dashboard instead of the page they were sent. -->
                <data android:scheme="https" android:host="taxify.mikesapphub.com" android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <!--
          What a pushed notification looks like when the app is not running.
          Without these Android draws the launcher icon squashed into the status
          bar, which comes out as a grey square.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_taxify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_blue" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="taxify_default" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Why "Take photo" opened a file picker instead of the camera.

      Tapping it puts a capture request to the webview, and Capacitor answers it
      by building an ACTION_IMAGE_CAPTURE intent and asking
      resolveActivity() which app would handle it. From Android 11 onwards an
      app cannot see another app it has not declared an interest in, so that
      call came back null, Capacitor decided no camera existed, and quietly fell
      back to the ordinary file picker. Nothing failed and nothing was logged
      where anybody would see it — it just was not the camera.

      Declaring the intent here is what makes the camera visible to us. It is a
      visibility declaration and not a permission: it grants nothing, and only
      lets us ask who handles taking a photo.

      Note what is deliberately absent — android.permission.CAMERA. Capacitor
      treats a declared CAMERA permission as one it must hold before it will
      open the camera at all, so adding it would put a permission prompt in
      front of every first photo. We never touch the camera ourselves; the
      camera app does, under its own permission, and hands back a file.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
